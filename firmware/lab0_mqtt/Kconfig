mainmenu "Lab 0 - Minimal IoT Implementation (MQTT)"

config LAB_WIFI_SSID
	string "Wi-Fi SSID"
	default "changeme"
	help
	  Name of the 2.4 GHz network the node joins. The ESP32-C6 radio does
	  not associate with 5 GHz-only APs.

config LAB_WIFI_PSK
	string "Wi-Fi password"
	default "changeme"

# -----------------------------------------------------------------------------
# TASK 2 - Tell the node where the broker is.
#
# In the HTTP lab the dashboard needed the *node's* address. Here the node needs
# the *broker's* address, and the dashboard needs neither. Declare two symbols:
#
#   LAB_BROKER_ADDR - string, the broker's IPv4 address, default "192.168.1.50"
#   LAB_BROKER_PORT - int,    the broker's TCP port,     default 1883
#
# main.c already refers to CONFIG_LAB_BROKER_ADDR and CONFIG_LAB_BROKER_PORT,
# so the build fails until both exist. Follow the style of the two symbols
# above, and explain the reversal in your DDR.
# -----------------------------------------------------------------------------

source "Kconfig.zephyr"
